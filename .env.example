# Copie para .env e ajuste os valores. O arquivo .env NUNCA deve ser versionado.

# --- Banco de dados ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ponto
DB_USERNAME=ponto
DB_PASSWORD=troque-esta-senha
DB_POOL_SIZE=10

# --- Aplicacao ---
SERVER_PORT=8080
APP_TIMEZONE=America/Sao_Paulo
APP_API_DOCS_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Autenticacao ---
# Segredo dos tokens JWT: minimo 32 caracteres aleatorios.
APP_JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres
APP_JWT_TTL=PT8H
# Unico dominio de e-mail aceito no cadastro de usuarios.
APP_EMAIL_DOMAIN=relatar.com.br
# Opcional: administrador criado somente na primeira inicializacao (banco sem usuarios).
# Deixe em branco depois de criado, para nao manter a senha em arquivo.
APP_ADMIN_NAME=Administrador
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# Exige a localizacao do dispositivo para registrar o ponto.
APP_LOCATION_REQUIRED=true
# Restringe o ponto a Rua Waldemiro Alberto Hulle (tracado no application.yml).
APP_AREA_ENABLED=true
APP_AREA_TOLERANCE_M=60
APP_AREA_MAX_ACCURACY_M=100
# Chave da Google Geocoding API para mostrar o nome da rua. Vazia = usa o OpenStreetMap.
APP_GOOGLE_MAPS_API_KEY=

# --- Verificacao de relogio (NTP) ---
APP_NTP_CHECK_ENABLED=true
APP_NTP_SERVER=a.st1.ntp.br
APP_NTP_MAX_OFFSET=PT1S
